#include <stdio.h>
void main()
{
  int num, rev, og, d;
    rev=0;
    printf("Enter to check pallindrome: ");
    scanf("%d",&num);
    og=num;
    while (num>0)
        {
            d=num%10;
            rev=rev*10+d;
            num=num/10;
        }
    printf("reverse of the number:%d", rev);
    if (og==rev)
    {
        printf("Number is pallindrome.");
    }
    else
    {
        printf("Number is not pallindrome.");
    }
}
